APP_NAME=Pano
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://pano.test

# Musician provider settings (the existing provider values remain the defaults).
MUSICIAN_REFRESH=true
# MUSICIAN_API_URL=https://wavechannel.ir/api/songs/list?from=2025-01-01&to=2026-01-01
# MUSICIAN_API_TOKEN=your-provider-token

# Guessing (the module defaults apply when these are omitted).
# KALAQPAR_DATABASE=E:/data/kalaqpar.sqlite
# KALAQPAR_DEFAULT_ROUNDS=5
# KALAQPAR_REVEAL_SECONDS=12
# KALAQPAR_WORKER_INTERVAL=1
# KALAQPAR_WORKER_TICKS=0

# Kalaqpar optional email accounts (application root, including any subdirectory).
# KQ_PUBLIC_BASE_URL=https://example.com/play
# APP_ENV=production
# APP_DEBUG=false
# KQ_SECURE_COOKIE=true
# Recovery also requires a once-per-minute `php pano kalaqpar kalaqpar:mail` task.
KQ_RECOVERY_ENABLED=false
KQ_SMTP_HOST=smtp.wavechannel.ir
KQ_SMTP_PORT=465
KQ_SMTP_ENCRYPTION=smtps
KQ_SMTP_USERNAME=kalaqpar@tolio.ir
KQ_SMTP_PASSWORD=replace-with-hosting-secret
KQ_MAIL_FROM=kalaqpar@tolio.ir
KQ_MAIL_FROM_NAME="کلاغ‌پر"
# Port 25 is opt-in only: KQ_SMTP_PORT=25 and KQ_SMTP_ENCRYPTION=starttls.
# Certificate/hostname verification and encryption remain mandatory; no fallback.
