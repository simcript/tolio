<IfModule mod_rewrite.c>
    RewriteEngine On

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    <IfModule mod_headers.c>
        RequestHeader append X-Forwarded-For "%{REMOTE_ADDR}s"
    </IfModule>

    # Preserve Authorization header (JWT / Bearer)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Keep bookmarks to the former standalone apps working.
    RewriteRule ^apps/(calma|colorfy|idate|laralog|musician|onregex|red-json)(?:/index\.(?:html|php))?/?$ /$1 [R=301,L]
    RewriteRule ^apps/musician/info\.php$ /musician/info [R=308,L]

    # Keep the Kalaqpar launch page inside its PWA scope (also under a prefix).
    # Remove other trailing slashes as before.
    RewriteCond %{REQUEST_URI} !/kalaqpar/$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Block direct access to any .php or .html file except index.php
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(?!index\.php$).+\.(php|html)$ - [F,L]

    # Serve existing non-PHP/non-HTML files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise forward to Front Controller
    RewriteRule ^ index.php [L]
</IfModule>
