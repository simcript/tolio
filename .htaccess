# فعال‌سازی mod_rewrite
RewriteEngine On

# استثنا: فایل‌های استاتیک (css, js, images, fonts, و ...) آزاد هستند
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$ [NC]

# فقط اجازه لود صفحات از داخل iframe دامنه مجاز tolio.ir
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?tolio\.ir [NC]
RewriteCond %{HTTP_REFERER} !^$
RewriteRule .* - [F,L]

# جلوگیری از دسترسی مستقیم (وقتی هیچ Referer وجود ندارد)
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$ [NC]
RewriteCond %{HTTP_REFERER} ^$
RewriteRule .* - [F,L]

# -----------------------------
# در سطح مرورگر (هدرهای امنیتی)
# -----------------------------
<IfModule mod_headers.c>
    # فقط اجازه iframe از tolio.ir
    Header always set X-Frame-Options "ALLOW-FROM https://tolio.ir"
    Header always set Content-Security-Policy "frame-ancestors 'self' https://tolio.ir"
</IfModule>

# -----------------------------
# تقویت امنیت HTTPS
# -----------------------------
<IfModule mod_ssl.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
